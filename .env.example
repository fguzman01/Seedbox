DATABASE_URL=postgres://postgres:postgres@localhost:5432/seedbox
# Used by `npm test` for the database integration tests (tests are skipped if unset).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/seedbox_test
ANTHROPIC_API_KEY=
# Reddit source (ADR-0006): create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=seedbox/0.1 by your_reddit_username
# Optional, comma separated (default: SaaS,smallbusiness,Entrepreneur,freelance,startups,sysadmin)
SEEDBOX_SUBREDDITS=
# Optional: model used to extract pains (default claude-opus-5-5), e.g. claude-haiku-5-5.
SEEDBOX_EXTRACTION_MODEL=
# Optional: model used to group pains into opportunities (default claude-opus-5-5).
SEEDBOX_CLUSTERING_MODEL=
# Optional: model used to assess competition and buildability (default claude-opus-5-5).
SEEDBOX_ASSESSMENT_MODEL=
# Required to edit (favorites, notes) in production: protects the whole site with user:password.
SEEDBOX_BASIC_AUTH=
# Claude Code analyst API (ADR-0008): required on the site to enable /api/agent/*.
SEEDBOX_AGENT_TOKEN=
# Used by `npm run agent` (the analyst's side): the deployed site's URL.
SEEDBOX_URL=
